# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/lakshmi_fh

# SendGrid Email Configuration (REQUIRED FOR EMAILS)
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# IMPORTANT: This email MUST be verified in SendGrid
# Go to: https://app.sendgrid.com/settings/sender_authentication
# And verify the domain or use a verified sender email
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Optional: Display name for emails
SENDGRID_FROM_NAME=Lakshmi Function Hall

# Admin email to receive booking notifications
ADMIN_EMAIL=admin@yourdomain.com

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration (if needed for frontend)
FRONTEND_URL=http://localhost:3000
